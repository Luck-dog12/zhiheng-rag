APP_ENV=development
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://rag:replace-me@your-postgres:5432/rag
SESSION_HOURS=12
UPLOAD_LIMIT_MB=50

S3_ENDPOINT_URL=https://your-s3-endpoint
S3_REGION=us-east-1
# Tencent COS: use regional endpoint https://cos.<region>.myqcloud.com (no bucket prefix),
# S3_SIGNATURE_VERSION=s3 and S3_ADDRESSING_STYLE=virtual.
S3_SIGNATURE_VERSION=s3v4
S3_ADDRESSING_STYLE=auto
S3_BUCKET=enterprise-rag
S3_ACCESS_KEY=
S3_SECRET_KEY=

MILVUS_URI=https://your-milvus-endpoint
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=rag_chunks_qwen37_v2

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Share DeepSeek credentials/model for coreference, metadata, agent decisions and answers.
COREFERENCE_USE_DEEPSEEK=true
# Coreference is bounded extraction; disable DeepSeek reasoning for this purpose only.
COREFERENCE_DEEPSEEK_THINKING=disabled
# Optional dedicated model: set COREFERENCE_USE_DEEPSEEK=false and fill all three fields below.
COREFERENCE_BASE_URL=
COREFERENCE_API_KEY=
COREFERENCE_MODEL=
EMBEDDING_BASE_URL=
# dashscope uses the full native endpoint; openai uses BASE_URL + /embeddings.
EMBEDDING_PROTOCOL=dashscope
EMBEDDING_ENDPOINT=https://YOUR-WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_REVISION=1
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=20
# Store both vectors to allow switching sparse retrieval without re-ingesting.
EMBEDDING_STORE_SPARSE=true
RETRIEVAL_SPARSE_MODE=bm25
RERANK_PROTOCOL=openai
RERANK_ENDPOINT=https://YOUR-WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank

HTTP_TIMEOUT_SECONDS=60
MODEL_CONCURRENCY=8
CHAT_CONCURRENCY=20
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=15
CHUNK_TARGET=1200
CHUNK_MAX=2000
CHUNK_OVERLAP=150
CLEAN_NORMALIZE_WHITESPACE=true
CLEAN_REMOVE_FILLERS=true
RETRIEVAL_PER_PATH=50
RETRIEVAL_MAX_PER_PATH=200
RETRIEVAL_CANDIDATES=100
RRF_K=60
ANSWER_TOP_K=5
# Thinking for query planning, evidence review and concise final answers; coreference remains disabled above.
AGENT_DEEPSEEK_THINKING=enabled
AGENT_REASONING_EFFORT=high
AGENT_INITIAL_TOKENS=8192
ANSWER_DEEPSEEK_THINKING=enabled
ANSWER_REASONING_EFFORT=high
ANSWER_INITIAL_TOKENS=8192
ANSWER_MAX_TOKENS=32768
ANSWER_MAX_ATTEMPTS=3
AGENT_MAX_STEPS=12
AGENT_MAX_SEARCHES=4
CHAT_TIMEOUT_SECONDS=480
PIPELINE_VERSION=1
